# Passo 1: Lê o valor e converte para float
valor = float(input("Digite um valor: "))

# Passo 2: Verifica se o valor está FORA do intervalo entre 0 e 100
if valor < 0 or valor > 100:
    # Se estiver fora, mostre o valor na tela
    print(f"O valor {valor} está fora do intervalo [0, 100].")
else:
    # Caso esteja dentro, o enunciado não pede ação, mas podemos confirmar:
    print("O valor está dentro do intervalo.")
