# Lê a entrada e converte para um número decimal
numero = float(input("Digite um número: "))

# Verifica se o número é positivo ou zero
if numero >= 0:
    # Calcula a raiz usando o operador de potência **
    raiz = numero ** 0.5
    print(f"A raiz aproximada de {numero} é {raiz:.2f}")
else:
    print("Número inválido")
